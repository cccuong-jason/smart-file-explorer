{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "smart-file-explorer",
  "version": "0.1.0",
  "identifier": "com.smartfileexplorer.web",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart File Explorer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      },
      {
        "label": "spotlight",
        "url": "/spotlight.html",
        "title": "Spotlight Search",
        "width": 640,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "tray-activity",
        "url": "/tray-activity.html",
        "title": "Tray Activity",
        "width": 320,
        "height": 106,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
